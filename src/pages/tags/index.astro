---
import Base from '../../layouts/Base.astro';
import { getCollection } from 'astro:content';
import { tagColor } from '../../lib/tags';
import { defaultLang, ui } from '../../lib/i18n';

const posts = await getCollection('posts');
const tagCount = new Map<string, number>();
for (const p of posts) for (const t of p.data.tags) tagCount.set(t, (tagCount.get(t) ?? 0) + 1);
const tags = [...tagCount.entries()].sort((a, b) => b[1] - a[1]);
const t = ui[defaultLang];
---

<Base title={t.tags} lang={defaultLang}>
  <p class="kicker" data-i18n="tags">{t.tags}</p>
  <ul class="tags">
    {tags.map(([tag, count], i) => (
      <li>
        <a class={i === 0 ? 'top' : ''} href={`/tags/${encodeURIComponent(tag)}`} style={`--c:${tagColor(tag)}`}>
          {tag} <span class="count">({count})</span>
        </a>
      </li>
    ))}
  </ul>
</Base>
<style>
  /* chip recipe mirrors .inline-tags in global.css (the source of truth) — same
     structure (tint over surface, tinted border, --radius), but this page runs
     larger (0.9rem) with --fg text since chips are its primary content.
     change both together */
  .tags { list-style: none; padding: 0; display: flex; flex-wrap: wrap; gap: 0.45rem; }
  .tags a {
    display: inline-block;
    font-size: 0.9rem;
    line-height: 1.4;
    color: var(--fg);
    text-decoration: none;
    padding: 0.22rem 0.75rem;
    border-radius: var(--radius);
    background: color-mix(in srgb, var(--c) 8%, var(--rp-surface));
    border: 1px solid color-mix(in srgb, var(--c) 26%, transparent);
    transition: background 0.15s var(--ease-out);
  }
  .tags a:hover,
  .tags a:focus-visible { background: color-mix(in srgb, var(--c) 20%, var(--rp-surface)); }
  /* most-used tag sits a shade stronger, like the reference's highlight */
  .tags a.top { background: color-mix(in srgb, var(--c) 16%, var(--rp-surface)); font-weight: 500; }
  .count { font-size: 0.8em; color: var(--rp-subtle); }
</style>
