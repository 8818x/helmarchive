---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import { Icon } from 'astro-icon/components';
import { tagColor } from '../lib/tags';
import { dateLong, defaultLang, ui } from '../lib/i18n';

interface Props {
  post: CollectionEntry<'posts'>;
}
const { post } = Astro.props;
const { Content } = await render(post);
const t = ui[defaultLang];

// author byline — per-post `author` frontmatter names the entity; each post
// declares its own writer. renders only when the entity exists.
const authorId = post.data.author;
const author = (await getCollection('entities')).find((e) => e.id === authorId);

// other posts sharing at least one tag — computed free, no extra frontmatter
const all = await getCollection('posts');
const related = all
  .filter((p) => p.id !== post.id && p.data.tags.some((t) => post.data.tags.includes(t)))
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
  .slice(0, 3);

// character count of the body as the reader sees it: markdown syntax stripped,
// then counted in grapheme clusters (Thai vowels/tone marks stack, not add)
const plain = (post.body ?? '')
  .replace(/```[\s\S]*?```/g, ' ') // code fences
  .replace(/!\[[^\]]*\]\([^)]*\)/g, ' ') // images — drop entirely
  .replace(/\[\[([^\]|]+)\|([^\]]+)\]\]/g, '$2') // [[id|label]] → label
  .replace(/\[\[([^\]]+)\]\]/g, '$1') // [[id]] → id
  .replace(/\[([^\]]*)\]\([^)]*\)/g, '$1') // [label](url) → label
  .replace(/`[^`]*`/g, ' ') // inline code
  .replace(/^\s*(?:>|#{1,6}|[-*+]\s|\d+\.\s)+/gm, '') // heading/quote/list markers
  .replace(/[*_]{1,3}/g, ''); // emphasis
const chars = [...new Intl.Segmenter('th', { granularity: 'grapheme' }).segment(plain)]
  .length;
// ponytail: fixed 500 chars/min — Thai silent reading runs ~400-600; tune here if it feels off
const minutes = Math.max(1, Math.ceil(chars / 500));
---

<article>
  <h1>{post.data.title}</h1>
  <p class="meta">
    {author && (
      <span class="meta-item">
        <Icon name="lucide:square-pen" />
        <a class="author" href={`/entities/${authorId}`}>{author.data.name}</a>
      </span>
    )}
    <span class="meta-item">
      <Icon name="lucide:calendar-days" />
      <time datetime={post.data.date.toISOString()} data-datefmt="long">{dateLong(post.data.date, defaultLang)}</time>
    </span>
    <span class="meta-item">
      <Icon name="lucide:letter-text" />
      {chars.toLocaleString()} <span data-i18n="charCount">{t.charCount}</span>
    </span>
    <span class="meta-item">
      <Icon name="lucide:clock" />
      {minutes} <span data-i18n="readTime">{t.readTime}</span>
    </span>
  </p>
  <ul class="inline-tags">
    {post.data.tags.map((t) => <li><a href={`/tags/${encodeURIComponent(t)}`} style={`--c:${tagColor(t)}`}>{t}</a></li>)}
  </ul>

  <div class="content">
    <Content />
  </div>

  <p class="disclaimer" data-i18n="disclaimer">{t.disclaimer}</p>

  {post.data.source && (
    <p class="source"><span data-i18n="source">{t.source}</span> <a href={post.data.source} target="_blank" rel="nofollow noopener">Facebook</a></p>
  )}

  {post.data.references.length > 0 && (
    <section class="references">
      <h2 data-i18n="references">{t.references}</h2>
      <ul>
        {post.data.references.map((r) => (
          <li><a href={r.url} rel="nofollow noopener">{r.label}</a></li>
        ))}
      </ul>
    </section>
  )}

  {related.length > 0 && (
    <section class="related">
      <h2 data-i18n="related">{t.related}</h2>
      <ul class="post-list">
        {related.map((p) => <li><a href={`/posts/${p.id}`}>{p.data.title}</a></li>)}
      </ul>
    </section>
  )}
</article>
