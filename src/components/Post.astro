---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import { Icon } from 'astro-icon/components';
import { tagColor } from '../lib/tags';
import { authorSlug } from '../lib/site';
import { dateLong, defaultLang, ui } from '../lib/i18n';

interface Props {
  post: CollectionEntry<'posts'>;
}
const { post } = Astro.props;
const { Content } = await render(post);
const t = ui[defaultLang];

// author byline — links to the author's entity hub. renders only when their entity exists
// (the template ships empty; graceful like every other optional field).
const author = (await getCollection('entities')).find((e) => e.id === authorSlug);

// other posts sharing at least one tag — computed free, no extra frontmatter
const all = await getCollection('posts');
const related = all
  .filter((p) => p.id !== post.id && p.data.tags.some((t) => post.data.tags.includes(t)))
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
  .slice(0, 3);
---

<article>
  <h1>{post.data.title}</h1>
  <p class="meta">
    {author && (
      <span class="meta-item">
        <Icon name="lucide:square-pen" />
        <a class="author" href={`/entities/${authorSlug}`}>{author.data.name}</a>
      </span>
    )}
    <span class="meta-item">
      <Icon name="lucide:calendar-days" />
      <time datetime={post.data.date.toISOString()} data-datefmt="long">{dateLong(post.data.date, defaultLang)}</time>
    </span>
  </p>
  <ul class="inline-tags">
    {post.data.tags.map((t) => <li><a href={`/tags/${encodeURIComponent(t)}`} style={`--c:${tagColor(t)}`}>{t}</a></li>)}
  </ul>

  <div class="content">
    <Content />
  </div>

  <p class="disclaimer" data-i18n="disclaimer">{t.disclaimer}</p>

  {post.data.source && (
    <p class="source"><span data-i18n="source">{t.source}</span> <a href={post.data.source} target="_blank" rel="nofollow noopener">Facebook</a></p>
  )}

  {post.data.references.length > 0 && (
    <section class="references">
      <h2 data-i18n="references">{t.references}</h2>
      <ul>
        {post.data.references.map((r) => (
          <li><a href={r.url} rel="nofollow noopener">{r.label}</a></li>
        ))}
      </ul>
    </section>
  )}

  {related.length > 0 && (
    <section class="related">
      <h2 data-i18n="related">{t.related}</h2>
      <ul class="post-list">
        {related.map((p) => <li><a href={`/posts/${p.id}`}>{p.data.title}</a></li>)}
      </ul>
    </section>
  )}
</article>
